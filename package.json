{
  "name": "voice-line",
  "private": true,
  "version": "0.0.0",
  "description": "Real-time voice layer for AI agents. You bring the brain — we handle the ears and mouth.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "dev": "pnpm -r --filter './packages/*' --parallel run dev",
    "test": "pnpm -r --filter './packages/*' run test",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "clean": "pnpm -r --filter './packages/*' run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.13.1",
    "tsup": "^8.3.6",
    "typescript": "^5.9.3",
    "vitest": "^3.0.5",
    "vue-tsc": "^3.3.8"
  }
}
